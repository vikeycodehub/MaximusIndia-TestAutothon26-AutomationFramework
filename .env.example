# Copy this file to .env and adjust for tomorrow's actual application under test (AUT)
TEST_ENV=dev
HEADLESS=true
BROWSER=chromium
DEFAULT_TIMEOUT_MS=15000

# --- Appium / native Android (only needed for the `appium` marked tests) ---
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_APP_PACKAGE=com.android.settings
ANDROID_APP_ACTIVITY=.Settings
# ANDROID_APP_PATH=C:\path\to\app-under-test.apk   # set this once tomorrow's APK is provided
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
